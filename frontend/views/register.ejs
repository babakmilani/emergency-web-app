<!--frontend/views/register.ejs-->
<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style-register.css">
    <link rel="stylesheet" href="/css/style-index.css">
    <link rel="stylesheet" href="/css/style-about.css">
    <link rel="stylesheet" href="/css/flashMsg.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <title>
        Emergencies
    </title>
</head>

<body>
    <div class="topnav">
        <a class="active" href="/">Home</a>
        <a href="about">About</a>
        <a href="register">Register</a>
    </div>

    <div class="login-button">
        <button onclick="document.getElementById('id01').style.display='block'" style="width:auto;">Login</button>
    </div>

    <div id="id01" class="modal">
        <form action="/signin" method="post" enctype="application/x-www-form-urlencoded" class=" modal-content animate">
            <div class="imgcontainer">
                <span onclick="document.getElementById('id01').style.display='none'" class="close"
                    title="Close">&times;</span>
                <img src="/img/login.jpg" alt="Avatar" style="width:75px; height:75px;">
            </div>

            <div class="container">
                <div class="input-group">
                    <input type="text" placeholder="Enter Username" name="username" id="username" required>
                    <span class="error" id="usernameError"></span>
                </div>
                <div class="input-group">
                    <input type="password" placeholder="Enter Password" name="psw" id="psw" required>
                    <span class="error" id="passwordError"></span>
                </div>
                <button type="submit" class="popup-login-btn">Login</button>
            </div>
            <hr>
            <div class="container">
                <button type="button" onclick="document.getElementById('id01').style.display='none'"
                    class="cancelbtn">Cancel</button>
                <span class="psw">Forgot <a href="#">password?</a></span>
            </div>
        </form>
    </div>

    <!-- Registration Form HTML Begin -->
    <div class="register-form">
        <form id="registrationForm" action="/register" enctype="application/x-www-form-urlencoded" method="POST">
            <div class="container">
                <h1>Register</h1>
                <p>Please fill in this form to create an account.</p>
                <hr>

                <div class="input-group">
                    <label for="fname"><b>First Name</b></label>
                    <input type="text" name="fname" id="fname" required>
                </div>
                <div class="input-group">
                    <label for="lname"><b>Last Name</b></label>
                    <input type="text" name="lname" id="lname" required>
                </div>
                <div class="input-group">
                    <label for="regUname"><b>User Name</b></label>
                    <input type="text" name="regUname" id="regUname" required>
                    <span class="error" id="regUname"></span>
                </div>
                <div class="input-group">
                    <label for="regEmail"><b>Email</b></label>
                    <input type="text" name="regEmail" id="regEmail" required>
                    <span class="error" id="emailError"></span>
                </div>
                <div class="input-group">
                    <label for="regPsw"><b>Password</b></label>
                    <input type="password" name="regPsw" id="regPsw" required>
                    <span class="error" id="passwordError"></span>
                </div>
                <div class="input-group">
                    <label for="regConfirmPassword"><b>Repeat Password</b></label>
                    <input type="password" name="regConfirmPassword" id="regConfirmPassword" required>
                    <span class="error" id="confirmPasswordError"></span>
                </div>

                <hr>
                <p>By creating an account you agree to our
                <div class="popup" onclick="popup()"><b>Policies & Terms</b>
                    <span class="popuptext" id="myPopup"><b>Privacy:</b> We will not share your data without consent, except as required by law.<br>
                        <b>Accuracy:</b> You are responsible for providing accurate and up-to-date information. False or misleading details may result in account suspension.<br>
                        <b>Account Security:</b> You are responsible for maintaining the confidentiality of your login credentials and for any activities under your account.<br>
                        <b>Usage:</b> By registering, you agree to use our platform in compliance with all applicable laws and our Terms of Service.<br> Misuse of the platform may lead to account termination.<br>
                        <b>Communication:</b> By signing up, you consent to receive important account-related emails and updates. You can manage communication preferences in your account settings.</span>
                </div>.</p>

                <button type="submit" class="registerbtn">Register</button>
            </div>
        </form>
        <!-- Registration Form HTML End -->
    </div>

    <div class="footer">
        <p class="footer-txt">Developed by Babak Milani for employment purposes. All rights reserved 2024.</p>
    </div>

    <!-- Flash Message Modal -->
    <div class="modalFlash" id="flashModal">
        <div class="modal-content-flash-msg">
            <p id="flashMessage"></p>
            <button onclick="closeFlashModal()">Close</button>
        </div>
    </div>

    <script>
        // Dynamically display flash messages from the server
        const successMessage = "<%= messages.success ? messages.success[0] : '' %>";
        const errorMessage = "<%= messages.error ? messages.error[0] : '' %>";

        if (successMessage) {
            document.getElementById("flashMessage").innerText = successMessage;
            document.getElementById("flashModal").style.display = "block";
        }
        if (errorMessage) {
            document.getElementById("flashMessage").innerText = errorMessage;
            document.getElementById("flashModal").style.display = "block";
        }
    </script>

    <script src="/javascript/flashMsg.js" defer></script>
    <script src="/javascript/register.js" defer></script>
    <script src="/javascript/policiesAndTerm.js" defer></script>
</body>

</html>