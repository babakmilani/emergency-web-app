<!--logs.ejs-->
<!DOCTYPE html>
<html lang="en">

<head>
    <title>Report</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/logs.css">
</head>

<body>

    <div class="header">
        <!--profile Image Section START-->
        <div class="profile-pic" title="add a profile picture">
            <% if (imagePath) { %>
                <img src="data:image/jpeg;base64,<%= imagePath %>" id="profile-image" alt="User Image"
                    style="cursor: pointer; width: 75px; height: 90px;">
                <% } else { %>
                    <img src="/img/default-pic.png" id="profile-image" alt="Upload Image"
                        style="cursor: pointer; width: 200px; height: 200px;">
                    <% } %>
                        <input type="file" id="image-upload" style="display: none;">
        </div>
        <!--profile Image Section END-->

        <form id="uploadForm" action="/logs/uploads" method="post" encType="multipart/form-data" style="display: none;">
            <input type="file" name="image" id="hidden-upload">
        </form>

        <h1>Welcome, <%= user.name %>!</h1>
    </div>

    <!--Menu Bar START-->
    <div class="topnav">
        <a href="/dashboard">Dashboard</a>
        <a href="/report">Report</a>
        <a href="/logs">Logs</a>
        <a href="/profile">Account</a>
        <a href="/logout">Logout</a>
    </div>
    <!--Menu Bar END-->

    <!--The Search Input Bar code START-->
    <div class="search-bgnd">
        <div class="search-box">
            <form action="/logs" method="GET">
                <button class="btn-search"><i class="fas fa-search"></i></button>
                <input type="text" class="input-search" name="q" id="q" placeholder="flood, terrorism, wildfire, cyberthreat">
            </form>
        </div>
    </div>
    <!--Search Input Bar code END-->

    <div class="container text-center" id="results">
        <% if (results && results.length > 0) { %>
            <% results.forEach(result => { %>
                <div class="row mb-3">
                    <div class="col-6 bg-primary text-white p-3">
                        <strong>#:</strong> <%= result.id %><br>
                        <strong>Agency:</strong> <%= result.agency || 'Unknown' %>
                    </div>
                    <div class="col-6 bg-success text-white p-3">
                        <strong>Emergency:</strong> <%= result.emergency || 'Unknown' %><br>
                        <strong>Address:</strong> <%= result.address || 'Unknown' %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No results found.</p>
        <% } %>
    </div>
    


    <div class="footer">
        <p class="footer-txt">Developed by Babak Milani for employment purposes. All rights reserved 2024.</p>
    </div>
    .
    <!-- Add JavaScript to show the popup -->
    <% if (successMessage.length> 0) { %>
        <script>
            alert("<%= successMessage[0] %>");
        </script>
        <% } %>

          
            <script src="/javascript/dashboard.js"></script>
            <script src="/javascript/flashMsg.js"></script>

            <script src="/javascript/search.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>

