<!--frontend/views/report.ejs-->
<!DOCTYPE html>
<html lang="en">

<head>
    <title>Report</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/report.css">
    <link rel="stylesheet" href="/css/flashMsg.css">
</head>

<body>
    <div class="header">
        <div class="profile-pic" title="add a profile picture">

            <% if (imagePath) { %>
                <img src="data:image/jpeg;base64,<%= imagePath %>" id="profile-image" alt="User Image"
                    style="cursor: pointer; width: 75px; height: 90px;">
            <% } else { %>
                <img src="/img/default-pic.png" id="profile-image" alt="Upload Image"
                    style="cursor: pointer; width: 200px; height: 200px;">
            <% } %>
            <input type="file" id="image-upload" style="display: none;">
        </div>

        <form id="uploadForm" action="/report/uploads" method="post" encType="multipart/form-data"
            style="display: none;" autocomplete="off">
            <input type="file" name="image" id="hidden-upload">
        </form>

        <h1>Welcome, <%= user.name %>!</h1>
    </div>

    <div class="topnav">
        <a href="/dashboard">Dashboard</a>
        <a href="/report">Report</a>
        <a href="/logs">Logs</a>
        <a href="/profile">Account</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="container">
        <form id="report-data" action="/report" method="post" autocomplete="off">
            <h3>Enter your emergency here for the public safety of the State of California</h3>
            <h4>Your report will be immediately announced and reported!</h4>
            <fieldset>
                <input placeholder="Your Agency" type="text" id="agency" name="agency" tabindex="1" autocomplete="off"
                    required autofocus>
            </fieldset>
            <fieldset>
                <input placeholder="The Emergency" type="text" id="emergency" name="emergency" tabindex="2"
                    autocomplete="off" required>
            </fieldset>
            <fieldset>
                <input placeholder="Threat (low, medium, high)" type="text" id="threat" name="threat" tabindex="3"
                    autocomplete="off" required>
            </fieldset>
            <fieldset>
                <input placeholder="Enter the address" type="text" id="address" name="address" tabindex="4"
                    autocomplete="off" required>
            </fieldset>
            <fieldset>
                <input placeholder="Enter the state" type="text" id="state" name="state" tabindex="5" autocomplete="off"
                    required>
            </fieldset>
            <fieldset>
                <input placeholder="Enter the zip code" type="text" id="zip" name="zip" tabindex="6" autocomplete="off"
                    required>
            </fieldset>
            <fieldset>
                <button type="submit" name="submit" id="contact-submit" data-submit="...Sending">Submit</button>
            </fieldset>
        </form>

        <div class="footer">
            <p class="footer-txt">Developed by Babak Milani for employment purposes. All rights reserved 2024.</p>
        </div>

        <!-- Flash Message Modal -->
        <div class="modalFlash" id="flashModal" style="display: none;">
            <div class="modal-content-flash-msg">
                <p id="flashMessage"></p>
                <button onclick="closeFlashModal()">Close</button>
            </div>
        </div>

    </div>

    <!-- Add JavaScript to show the popup -->
    <script>
        // Dynamically display flash messages from the server
        const successMessage = "<%= successMessage && successMessage[0] ? successMessage[0] : '' %>";
        const errorMessage = "<%= messages.error && messages.error[0] ? messages.error[0] : '' %>";

        // Show the flash message if available
        if (successMessage) {
            document.getElementById("flashMessage").innerText = successMessage;
            document.getElementById("flashModal").style.display = "block";
        } else if (errorMessage) {
            document.getElementById("flashMessage").innerText = errorMessage;
            document.getElementById("flashModal").style.display = "block";
        }
    </script>

    <script src="/javascript/dashboard.js" defer></script>
    <script src="/javascript/report.js" defer></script>
</body>

</html>
