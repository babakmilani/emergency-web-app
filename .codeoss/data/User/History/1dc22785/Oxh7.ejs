<!--index.ejs-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style-index.css">
    <link rel="stylesheet" href="/css/flashMsg.css">
    <link rel="icon" href="/frontend/public/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<title>
    Emergencies
</title>
</head>

<body>
    <div class="topnav">
        <a class="active" href="/">Home</a>
        <a href="about">About</a>
        <a href="register">Register</a>
        <div class="login-btn">
            <button onclick="document.getElementById('id01').style.display='block'" class="login-btn">Login</button>
        </div>
    </div>

    <div id="id01" class="modal">
        <form action="/signin" method="post" class="modal-content animate" enctype="application/x-www-form-urlencoded" autocomplete="off">
            <div class="imgcontainer">
                <span onclick="document.getElementById('id01').style.display='none'" class="close"
                    title="Close">&times;</span>
                <img src="/img/login.jpg" alt="Avatar" style="width:75px; height:75px;">
            </div>

            <div class="container">
                <div class="input-group">
                    <input type="text" placeholder="Enter Username" name="username" id="username" autocomplete="off" required>
                    <span class="error" id="usernameError"></span>
                </div>
                <div class="input-group">
                    <input type="password" placeholder="Enter Password" name="psw" id="psw" autocomplete="off" required>
                    <span class="error" id="passwordError"></span>
                </div>
                <button type="submit" class="popup-login-btn">Login</button>

            </div>
            <hr>
            <div class="container">
                <button type="button" onclick="document.getElementById('id01').style.display='none'"
                    class="cancelbtn">Cancel</button>
                <span class="psw">Forgot <a href="#">password?</a></span>
            </div>
        </form>
    </div>
    <div style="padding-left:16px; padding-top:16px">
        <h2>Emergency</h2>
        <p>Search and find emergencies in California.</p>
        <p>Earthquake, Fire, Flood, Natural Disaster, and Terrorism.</p>
        <p>Signup to receive notification when new emergencies are reported.</p>
        </<div>

        <div class="input-group-parent">
            <div class="input-container">
                <input type="text" name="text" class="input" placeholder="search...">
                <span class="icon">
                    <svg width="19px" height="19px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path opacity="1" d="M14 5H20" stroke="#000" stroke-width="1.5" stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path opacity="1" d="M14 8H17" stroke="#000" stroke-width="1.5" stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path d="M21 11.5C21 16.75 16.75 21 11.5 21C6.25 21 2 16.75 2 11.5C2 6.25 6.25 2 11.5 2"
                                stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path opacity="1" d="M22 22L20 20" stroke="#000" stroke-width="3.5" stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </g>
                    </svg>
                </span>
            </div>
        </div>
        <div class="button-group-parent">
            <button class="Btn">
                <span class="svgContainer">
                    <svg viewBox="0 0 496 512" height="1.6em" xmlns="http://www.w3.org/2000/svg" fill="white">
                        <path
                            d="M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3 .7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.6-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z"
                            fill="white"></path>
                    </svg>
                </span>
                <span class="BG"></span>
            </button>
        </div>

        <button class="open-button" onclick="openForm()">Sign up</button>

        <div class="form-popup" id="myForm" enctype="application/x-www-form-urlencoded">
            <form action="/signup" method="POST" class="form-container">
                <h2>Sign up</h2>

                <label for="fullname"><b>Name</b></label>
                <input type="text" placeholder="Enter Your Name" name="fullname" id="fullname" required>
                <span class="error" name="fullName" id="fullName"></span>

                <label for="email"><b>Email</b></label>
                <input type="text" placeholder="Enter Email" name="emailSign" id="emailSign" required>
                <span class="error" id="emailError"></span>

                <label for="sms"><b>Mobile</b></label>
                <input type="text" placeholder="Enter Mobile Number" name="sms" id="sms" required>
                <span class="error" id="smsError"></span>

                <button type="submit" class="btn">Sign Up</button>
                <button type="button" class="btn cancel" onclick="closeForm()">Close</button>
            </form>
        </div>

        <div id="map"></div>
        <div class="footer">
            <p class="footer-txt">Developed by Babak Milani for employment purposes. All rights reserved 2024.</p>
        </div>
    </div>
    <!-- Flash Message Modal -->
    <div class="modalFlash" id="flashModal">
        <div class="modal-content-flash-msg">
            <p id="flashMessage"></p>
            <button onclick="closeFlashModal()">Close</button>
        </div>
    </div>
    <script>

        // Fetch messages from server-side
        const successMessage = "<%= messages.success ? messages.success[0] : '' %>";
        const errorMessage = "<%= messages.error ? messages.error[0] : '' %>";
    </script>
    <script src="/javascript/flashMsg.js"></script>
    <script src="/javascript/register.js"></script>
    <script src="/javascript/signupForm.js"></script>
    <script
        src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.MAPS_API %>&libraries=places&callback=initializeMap"
        async defer></script>
    <script src="/javascript/googleMaps.js"></script>
</body>

</html>